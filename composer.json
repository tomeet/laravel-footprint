{
    "name": "tomeet/laravel-footprint",
    "description": "User footprint (browsing history) feature for Laravel Application.",
    "keywords": ["laravel", "footprint", "history", "track", "view"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tomeet",
            "email": "tomeet@sohu.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Tomeet\\Laravel\\Footprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomeet\\Laravel\\Footprint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tomeet\\Laravel\\Footprint\\FootprintServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
